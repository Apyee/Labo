---
const { tool } = Astro.props;

// Affiché en pied de fiche : donne la destination avant le clic.
const host = new URL(tool.url).hostname.replace(/^www\./, "");
---

<li class="tool">
  <a class="tool-link" href={tool.url} target="_blank" rel="noopener noreferrer">
    <h3 class="tool-name">
      {tool.name}
      {tool.example && <span class="tool-badge">exemple</span>}
    </h3>

    <p class="tool-summary">{tool.summary}</p>

    <div class="tool-meta">
      {tool.tags?.length > 0 && (
        <ul class="tool-tags">
          {tool.tags.map((t) => <li>{t}</li>)}
        </ul>
      )}
      <span class="tool-host">{host}</span>
    </div>
  </a>
</li>
